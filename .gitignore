# ---------------------------------------------------------------------------
# Dataset generado
# ---------------------------------------------------------------------------
# rides.csv, stream.csv y edges.csv pesan ~80 MB y son reproducibles byte a
# byte con un solo comando (python run_all.py todo), porque los generadores de
# src/wN/dataset.py son deterministas para unos parametros y una semilla
# dados. No tiene sentido versionarlos.
data/rides.csv
data/*.csv

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------------------------------------------------------------------------
# App web (web/)
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
next-env.d.ts
.vercel/
*.tsbuildinfo

# Generados por scripts/sync-python.mjs desde ../src y ../contratos — no se editan a mano.
web/public/py/
web/lib/generated/

# Variables de entorno. El proyecto no necesita ninguna, pero si alguien
# agrega un .env local no debe terminar en el repo.
.env
.env.local
.env*.local

# ---------------------------------------------------------------------------
# Sistema operativo y editores
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/settings.json

.vercel
