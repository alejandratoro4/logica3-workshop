# Vercel ignora .gitignore cuando existe este archivo, asi que aca va todo.
#
# Lo que SI necesita el build (no excluir):
#   web/                          fuente Next.js
#   src/wN/*.py                   los copia scripts/sync-python.mjs a public/py/
#   dashboard/contrato.py         idem
#   contratos/*.md                idem, y de ahi salen los tipos de lib/generated/
#   web/public/data/canonical-wN.json  corridas precomputadas (Vercel no tiene Python)

# Datasets generados (~80 MB), se reconstruyen con python run_all.py todo
# La barra inicial ancla a la raiz: sin ella se excluiria web/public/data/,
# donde viven las corridas canonicas.
/data/

# Salida del pipeline local. El dashboard no la lee en el build: usa la corrida
# canonica ya exportada a web/public/data/.
/results/

# Entrada de desarrollo, no de build
run_all.py
README.md

# Generados o instalados durante el build
node_modules/
.next/
out/
__pycache__/
*.py[cod]
web/public/py/
web/lib/generated/
*.tsbuildinfo

# Credenciales
.env
.env*.local
